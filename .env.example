# Site Phase Rollout ('prelaunch' | 'live')
NEXT_PUBLIC_SITE_PHASE=live

# InsForge Backend BaaS
NEXT_PUBLIC_INSFORGE_URL=https://your-project.eu-central.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your_insforge_anon_key
INSFORGE_SERVICE_ROLE_KEY=your_insforge_service_role_key

# Paystack Payment Gateway
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=orders@mail.empressglowemporium.com

# Analytics & Compliance
NEXT_PUBLIC_GA_ID=G-YOURGAID
NEXT_PUBLIC_META_PIXEL_ID=YOUR_PIXEL_ID
NDPC_DPO_EMAIL=dpo@empressglowemporium.com
